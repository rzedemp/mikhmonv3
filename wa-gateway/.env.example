PORT=3001

# WAJIB DIGANTI: Generate key acak minimal 32 karakter
# Contoh generate di terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=GANTI-DENGAN-KEY-RAHASIA-ANDA-MINIMAL-32-KARAKTER

# WhatsApp Gateway Anti-Ban Settings
# Daily message limit
MAX_MSGS_PER_DAY=50
# Hourly message limit
MAX_MSGS_PER_HOUR=10
# Message delays in milliseconds (human-like delays)
SEND_MIN_DELAY_MS=3000
SEND_MAX_DELAY_MS=8000

# Warm-up mode (for new SIM cards / new numbers)
WARMUP_MODE=false
WARMUP_DAYS_ELAPSED=0
